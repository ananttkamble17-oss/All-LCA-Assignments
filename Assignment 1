#include <stdio.h>
#include <string.h>

int main() {
    char email[50], password[50];
    char correctEmail[] = "user@gmail.com";
    char correctPass[] = "pass123";

    printf("Enter email: ");
    scanf("%49s", email);
    printf("Enter password: ");
    scanf("%49s", password);

    if (strcmp(email, correctEmail) == 0 && strcmp(password, correctPass) == 0)
        printf("Login successful. Welcome to Gmail!\n");
    else
        printf("Invalid email or password. Login failed.\n");

    return 0;
}
