#include <stdio.h>

/* Returns 1 if year is leap, else 0 */
int isLeap(int year)
{
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

/* Returns number of days in given month (1-12) of given year */
int daysInMonth(int month, int year)
{
    int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

    if (month == 2 && isLeap(year))
        return 29;
    return days[month - 1];
}

/* Returns weekday of 1st January: 0 = Sunday, 1 = Monday, ... 6 = Saturday */
int firstDayOfYear(int year)
{
    int y = year - 1;
    return (1 + 5 * (y % 4) + 4 * (y % 100) + 6 * (y % 400)) % 7;
}

int main()
{
    int year, month, day, start, total, i;
    char *monthName[] = {"January", "February", "March", "April",
                         "May", "June", "July", "August",
                         "September", "October", "November", "December"};

    printf("Enter year: ");
    scanf("%d", &year);

    start = firstDayOfYear(year);   /* weekday of 1 Jan */

    for (month = 1; month <= 12; month++)
    {
        total = daysInMonth(month, year);

        printf("\n   ------------ %s %d ------------\n", monthName[month - 1], year);
        printf("  Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

        /* leading spaces before the 1st day */
        for (i = 0; i < start; i++)
            printf("     ");

        for (day = 1; day <= total; day++)
        {
            printf("%5d", day);
            start++;
            if (start == 7)         /* end of week, go to next line */
            {
                printf("\n");
                start = 0;
            }
        }
        printf("\n");
    }

    return 0;
}
