#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char s1[100], s2[100], temp[200];
    int choice, i;

    printf("Enter first string: ");
    scanf("%99s", s1);

    do {
        printf("\n--- String Operations Menu ---\n");
        printf("1. Length (strlen)\n");
        printf("2. Copy (strcpy)\n");
        printf("3. Concatenate (strcat)\n");
        printf("4. Compare (strcmp)\n");
        printf("5. Reverse (strrev logic)\n");
        printf("6. Convert to Uppercase\n");
        printf("7. Convert to Lowercase\n");
        printf("8. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Length = %lu\n", strlen(s1));
                break;
            case 2:
                strcpy(s2, s1);
                printf("Copied string = %s\n", s2);
                break;
            case 3:
                printf("Enter second string: ");
                scanf("%99s", s2);
                strcpy(temp, s1);
                strcat(temp, s2);
                printf("Concatenated string = %s\n", temp);
                break;
            case 4:
                printf("Enter second string: ");
                scanf("%99s", s2);
                if (strcmp(s1, s2) == 0)
                    printf("Strings are equal\n");
                else
                    printf("Strings are not equal\n");
                break;
            case 5:
                strcpy(temp, s1);
                {
                    int n = strlen(temp);
                    for (i = 0; i < n / 2; i++) {
                        char t = temp[i];
                        temp[i] = temp[n - 1 - i];
                        temp[n - 1 - i] = t;
                    }
                }
                printf("Reversed string = %s\n", temp);
                break;
            case 6:
                strcpy(temp, s1);
                for (i = 0; temp[i]; i++)
                    temp[i] = toupper(temp[i]);
                printf("Uppercase = %s\n", temp);
                break;
            case 7:
                strcpy(temp, s1);
                for (i = 0; temp[i]; i++)
                    temp[i] = tolower(temp[i]);
                printf("Lowercase = %s\n", temp);
                break;
            case 8:
                printf("Exiting...\n");
                break;
            default:
                printf("Invalid choice\n");
        }
    } while (choice != 8);

    return 0;
}
