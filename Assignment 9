#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fp1, *fp2;
    char source[50], dest[50];
    int ch;

    printf("Enter the source file name: ");
    scanf("%s", source);
    printf("Enter the destination file name: ");
    scanf("%s", dest);

    fp1 = fopen(source, "r");
    if (fp1 == NULL)
    {
        printf("Cannot open source file %s\n", source);
        exit(1);
    }

    fp2 = fopen(dest, "w");
    if (fp2 == NULL)
    {
        printf("Cannot open destination file %s\n", dest);
        fclose(fp1);
        exit(1);
    }

    while ((ch = fgetc(fp1)) != EOF)
        fputc(ch, fp2);

    printf("File copied successfully\n");

    fclose(fp1);
    fclose(fp2);

    return 0;
}
